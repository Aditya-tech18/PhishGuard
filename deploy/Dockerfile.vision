FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PHISHGUARD_TORCH_THREADS=2
WORKDIR /app
COPY pyproject.toml README.md LICENSE requirements-tested.txt ./
COPY src ./src
# Explicit CPU wheels avoid silently pulling a GPU/CUDA runtime for local image inference.
ARG TORCH_VERSION=2.15.0
RUN pip install --no-cache-dir "torch==${TORCH_VERSION}" "torchvision==0.29.2" --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -c requirements-tested.txt '.[api,vision]' && useradd --uid 10001 --create-home phishguard
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["uvicorn", "phishguard.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
